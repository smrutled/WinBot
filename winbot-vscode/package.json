  "scripts": {
    "vscode:prepublish": "npm run build",
    "copy:exe": "node -e \"const fs=require('fs'); if(!fs.existsSync('bin')) fs.mkdirSync('bin'); fs.copyFileSync('../build/bin/Release/WinBot.exe', 'bin/WinBot.exe');\"",
    "build:ts": "node esbuild.js",
    "build": "npm run copy:exe && npm run build:ts",
    "package": "vsce package",
    "compile": "tsc -noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  },
  "publisher": "smrutled",
  "author": "smrutled",
  "repository": {
