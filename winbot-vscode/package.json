{
  "name": "winbot-vscode",
  "displayName": "WinBot Tools",
  "description": "WinBot UI Automation tools exposed as VS Code Language Model Tools",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "winbot_ui_scan",
        "displayName": "UI Scan",
        "modelDescription": "Scan the UI Automation tree of the currently focused window.",
        "tags": [
          "winbot",
          "github-copilot",
          "automation"
        ],
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "winbot_ui_scan"
      },
      {
        "name": "winbot_screenshot",
        "displayName": "Screenshot",
        "modelDescription": "Capture a full-resolution screenshot of the entire desktop.",
        "tags": [
          "winbot",
          "github-copilot",
          "automation"
        ],
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "winbot_screenshot"
      },
      {
        "name": "winbot_screenshot_window",
        "displayName": "Screenshot Window",
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "modelDescription": "Capture a screenshot of a specific window identified by a title substring.",
        "tags": [
          "winbot",
          "github-copilot",
          "automation"
        ],
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "winbot_screenshot_window"
      },
      {
        "name": "winbot_ui_scan_window",
        "displayName": "UI Scan Window",
        "inputSchema": {
          "type": "object",
