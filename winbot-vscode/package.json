            "title": {
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "modelDescription": "Scan the UI Automation tree of a specific window (searching by title substring).",
        "tags": [
          "winbot",
          "github-copilot",
          "automation"
        ],
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "winbot_ui_scan_window"
      },
      {
