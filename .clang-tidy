---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-throwing-static-initialization,
  -cert-err58-cpp,
  -cert-msc30-c,
  -cert-msc50-cpp,
  -clang-analyzer-optin.*,
  -clang-analyzer-security.ArrayBound,
  -cppcoreguidelines-avoid-magic-numbers,
  -modernize-raw-string-literal,
  -modernize-use-designated-initializers,
  -modernize-use-integer-sign-comparison,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-qualified-auto,
  -readability-static-accessed-through-instance

WarningsAsErrors: '*'

HeaderFilterRegex: 'WinBot[/\\](src|include)[/\\].*'

FormatStyle: file

CheckOptions:
  cppcoreguidelines-avoid-non-const-global-variables.AllowInternalLinkage: 'true'
  performance-for-range-copy.WarnOnAllAutoCopies: 'true'
  # Only flag long runs of same-typed parameters such as drag(x1, y1, x2, y2).
  bugprone-easily-swappable-parameters.MinimumLength: '4'